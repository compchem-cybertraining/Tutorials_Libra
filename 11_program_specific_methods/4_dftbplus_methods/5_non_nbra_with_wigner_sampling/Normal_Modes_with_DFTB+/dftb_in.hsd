Geometry = GenFormat {
  <<< "x1.gen"
}

Driver = SecondDerivatives {
  Delta = 0.01
}

Hamiltonian = DFTB {
  SCC = Yes
  SCCTolerance = 1.0E-10

  MaxAngularMomentum = {
    C = "p"
    H = "s"
    N = "p"
  }

  SlaterKosterFiles = Type2FileNames {
    Prefix = "/user/someshch/somesh1/dftb+/cyclopropanone/mio/FinalSK/"
    Separator = "-"
    Suffix = ".skf"
  }

  Filling = Fermi {
    Temperature [K] = 0.5
  }
}

Options = {
  WriteDetailedXml = Yes
}

Analysis = {}
