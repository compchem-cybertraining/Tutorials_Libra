Geometry = GenFormat {
  <<< "x1.gen"
}
Driver = {}

Hamiltonian = DFTB {
    SCC = Yes
    SCCTolerance = 1.0E-10
    MaxAngularMomentum = { O = "p" 
                          H = "s" 
                     }
                     
    SlaterKosterFiles = Type2FileNames {
        Prefix = "../mio/FinalSK/"
        Separator = "-"
        Suffix = ".skf"
    }
    Filling = Fermi {
                         Temperature [K] = 40    
                         }
                         
}

Options {
  WriteAutotestTag = Yes
  WriteHS = Yes
}
Analysis {
  WriteEigenvectors = Yes
  EigenvectorsAsText = Yes
  PrintForces = Yes
}
